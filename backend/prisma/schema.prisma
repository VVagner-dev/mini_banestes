// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model conta {
  id String @id @default(uuid())

  nome  String
  cpf   String @unique
  senha String

  saldo Decimal @default(0)

  pix                 pixKeys[]
  transacaosEnviadas  transacao[]     @relation("Pagador")
  transacaosRecebidas transacao[]     @relation("Remetente")
  refreshTokens       refreshTokens[]

  @@map("contas")
}

model pixKeys {
  id      String @id @default(uuid())
  key     String @unique @map("pix_key")
  conta   conta  @relation(fields: [contaId], references: [id])
  contaId String

  @@map("pix_keys")
}

model transacao {
  id String @id @default(uuid())

  pagador   conta  @relation("Pagador", fields: [pagadorId], references: [id])
  pagadorId String @map("pagador_id")

  remetente   conta  @relation("Remetente", fields: [remetenteId], references: [id])
  remetenteId String @map("remetente_id")

  valor    Decimal
  DataHora DateTime @default(now()) @map("data_hora")

  @@map("transacoes")
}

model refreshTokens {
  id    String @id @default(uuid())
  Token String

  userID String @map("user_id")
  user   conta  @relation(fields: [userID], references: [id])

  expiraEm DateTime @map("expira_em")
  revoked  Boolean  @default(false)

  @@map("refresh_tokens")
}
